{
  "name": "notedrop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && concurrently -k \"vite preview --configLoader native --port 5173\" \"wait-on tcp:5173 && electron .\"",
