    "start": "electron ."
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "latest",
    "electron": "latest",
    "vite": "^6.1.0",
    "wait-on": "latest"
  },
  "dependencies": {
    "react": "latest",
    "react-dom": "latest"
  },
  "main": "electron/main.cjs"
}
